CONFIG_SCHEMA_VERSION=1
INSTALLER=debian-preseed
ARCH=amd64
INSTALLER_VERSION=1.0.0
ENABLED_MODULES=core,ssh
DISABLED_MODULES=docker,tailscale,ansible,k3s,custom
DEBIAN_MAJOR=13
DEBIAN_RELEASE=stable
DEBIAN_ISO_URL=
DEBIAN_ISO_SHA256=
APT_MIRROR=deb.debian.org
HOSTNAME=omnixys-vm-01
DOMAIN=vm.local
FULLNAME="VM Admin"
USERNAME=vmadmin
PASSWORD=ChangeThisStrongPass123!

IDENTITY_SOURCE=usb-env
IDENTITY_REQUIRED=false
IDENTITY_FILE_PATH=/identity.env
IDENTITY_DEVICE_LABEL=OMNIXYS_ID
IDENTITY_EMBED=true

LANGUAGE=en
COUNTRY=DE
LOCALE=en_US.UTF-8
KEYBOARD=de
TIMEZONE=Europe/Berlin
TARGET_DISK_MODE=manual
TARGET_DISK=/dev/vda
PARTITION_MODE=erase
ERASE_DISK=true
FILESYSTEM=btrfs
INSTALL_OPENSSH=true
INSTALL_STANDARD_UTILITIES=true
INSTALL_FIRMWARE=false
INSTALL_UPDATES=true
SSH_PUBLIC_KEY=
SSH_PASSWORD_AUTH=false
SSH_PERMIT_ROOT_LOGIN=no
SUDO_NOPASSWD=true

# Network (optional – all four required for static IP)
NETWORK_INTERFACE=
STATIC_IP=
STATIC_ROUTERS=
STATIC_DNS=

REBOOT_AFTER_INSTALL=true
