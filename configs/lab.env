INSTALLER=debian-preseed
ARCH=amd64
INSTALLER_VERSION=1.0.0
DEBIAN_MAJOR=13
DEBIAN_RELEASE=stable
APT_MIRROR=ftp.de.debian.org
HOSTNAME=omnixys-lab-01
DOMAIN=lab.local
FULLNAME=Lab Admin
USERNAME=lab
PASSWORD=ChangeThisStrongPass!
LANGUAGE=en
COUNTRY=DE
LOCALE=en_US.UTF-8
KEYBOARD=de
TIMEZONE=Europe/Berlin
TARGET_DISK=/dev/sda
PARTITION_MODE=erase
ERASE_DISK=true
FILESYSTEM=xfs
INSTALL_OPENSSH=true
INSTALL_STANDARD_UTILITIES=true
INSTALL_FIRMWARE=true
INSTALL_UPDATES=false
SSH_PUBLIC_KEY=
SSH_PASSWORD_AUTH=true
SSH_PERMIT_ROOT_LOGIN=no
REBOOT_AFTER_INSTALL=true
