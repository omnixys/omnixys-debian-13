CONFIG_SCHEMA_VERSION=1
INSTALLER=debian-preseed
ARCH=amd64
INSTALLER_VERSION=1.0.0
ENABLED_MODULES=core,ssh
DISABLED_MODULES=docker,tailscale,ansible,k3s,custom
DEBIAN_MAJOR=13
DEBIAN_RELEASE=stable
APT_MIRROR=deb.debian.org
HOSTNAME=omnixys-prod-01
DOMAIN=corp.local
FULLNAME="Production Admin"
USERNAME=ops
PASSWORD=ChangeThisStrongPass!
LANGUAGE=en
COUNTRY=DE
LOCALE=en_US.UTF-8
KEYBOARD=de
TIMEZONE=Europe/Berlin
TARGET_DISK=/dev/sda
PARTITION_MODE=lvm
ERASE_DISK=true
FILESYSTEM=ext4
INSTALL_OPENSSH=true
INSTALL_STANDARD_UTILITIES=true
INSTALL_FIRMWARE=true
INSTALL_UPDATES=true
SSH_PUBLIC_KEY=
SSH_PASSWORD_AUTH=false
SSH_PERMIT_ROOT_LOGIN=no
REBOOT_AFTER_INSTALL=true
