# Framework
CONFIG_SCHEMA_VERSION=1
INSTALLER=debian-preseed
ARCH=amd64
INSTALLER_VERSION=1.0.0
ENABLED_MODULES=core,ssh
DISABLED_MODULES=docker,tailscale,ansible,k3s,custom

# Debian source selection
DEBIAN_MAJOR=13
DEBIAN_RELEASE=stable
DEBIAN_ISO_URL=
DEBIAN_ISO_SHA256=
APT_MIRROR=deb.debian.org

# Identity
HOSTNAME=omnixys-01
DOMAIN=local
FULLNAME="Caleb Gyamfi"
USERNAME=omnixys
PASSWORD=ChangeThisStrongPass123!


# Locale
LANGUAGE=en
COUNTRY=DE
LOCALE=en_US.UTF-8
KEYBOARD=de
TIMEZONE=Europe/Berlin

# Runtime identity override (optional MVP)
IDENTITY_SOURCE=none
IDENTITY_REQUIRED=false
IDENTITY_FILE_PATH=/identity.env
IDENTITY_DEVICE_LABEL=OMNIXYS-ID
PASSWORD_HASH=

# Storage
TARGET_DISK_MODE=auto
TARGET_DISK=
TARGET_DISK_BY_ID=
PARTITION_MODE=erase
ERASE_DISK=true
FILESYSTEM=ext4

# Package selection
INSTALL_OPENSSH=true
INSTALL_STANDARD_UTILITIES=true
INSTALL_FIRMWARE=true
INSTALL_UPDATES=true

# SSH hardening
SSH_PUBLIC_KEY=
SSH_PASSWORD_AUTH=false
SSH_PERMIT_ROOT_LOGIN=no
SUDO_NOPASSWD=true

# Runtime
REBOOT_AFTER_INSTALL=true
